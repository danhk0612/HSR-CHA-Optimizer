{
  "name": "hsr-cha-optimizer",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Local Honkai: Star Rail data collector and AI-ready exporter (no AI integration)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node src/sync.mjs",
    "import:archive": "node src/import-scanner.mjs",
    "import:scanner": "node src/import-scanner.mjs",
    "export:account": "node src/export-account.mjs",
    "export:character": "node src/export-character.mjs",
    "export:ai": "node src/export-ai.mjs",
    "gui": "node src/gui.mjs",
    "test": "node --test",
    "verify": "node --test && node src/verify.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "smoke:win": "node scripts/smoke-windows.mjs",
    "verify:win": "npm test && npm run dist:win && npm run smoke:win",
    "verify:local-win": "npm run verify && npm run dist:win && npm run smoke:win"
  },
  "main": "src/desktop.cjs",
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "kr.dk.hsrchaoptimizer",
    "productName": "HSR-CHA-Optimizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "!.local-data/**/*",
      "!test/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HSR-CHA-Optimizer-${version}-portable.${ext}",
      "icon": "build/icon.svg"
    }
  }
}
